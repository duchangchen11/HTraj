    "speed_vector_mean_low_lt": 0.2,
    "stationary_ratio": "zero-length path ratio numerical1 with defined=False; out/back requires path>=.5m",
    "terminal_unstable": "norm(last_velocity - time_weighted_mean_velocity)>=.5m/s",
